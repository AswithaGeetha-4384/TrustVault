TRUSTVAULT_SECRET_KEY=change-me-to-a-random-secret-key
TRUSTVAULT_DEBUG=1
TRUSTVAULT_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_SSLMODE=
MAX_UPLOAD_SIZE=26214400
PRIVATE_STORAGE_ROOT=private_storage
TRUSTVAULT_SECURE_SSL_REDIRECT=0
TRUSTVAULT_CSRF_TRUSTED_ORIGINS=
TRUSTVAULT_USE_X_FORWARDED_PROTO=0
TRUSTVAULT_HSTS_SECONDS=0
TRUSTVAULT_HSTS_SUBDOMAINS=0
TRUSTVAULT_HSTS_PRELOAD=0
